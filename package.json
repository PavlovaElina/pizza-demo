{
  "name": "pizza-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "node scripts/dev.mjs --preview",
    "lint": "eslint .",
    "format": "prettier --write src server scripts/*.mjs tests docs *.json *.ts *.js *.html README.md",
    "test": "vitest run src server",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build",
    "start": "node --env-file-if-exists=.env.local server/index.ts --serve"
  },
  "dependencies": {
    "msw": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-imask": "7.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
