# Copy to .env.local. Do not commit real keys.
# Public Maps JS API key: restrict domains to localhost and your HTTPS site.
YANDEX_MAPS_API_KEY=
# Private HTTP Geocoder key, read ONLY by the Node server. Never use a VITE_ prefix.
YANDEX_GEOCODER_API_KEY=
# Private Geosuggest key: used only by Node.js for address suggestions.
YANDEX_SUGGEST_API_KEY=
